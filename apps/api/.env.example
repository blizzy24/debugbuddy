# Port the API listens on
PORT=8787

# Supabase project settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key. Server-side only. Bypasses RLS. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production webhook URL of the DebugBuddy n8n workflow
N8N_WEBHOOK_URL=http://localhost:5678/webhook/debugbuddy-chat/chat

# Optional: if the n8n webhook uses Header Auth, the header name and value to send
# N8N_WEBHOOK_AUTH_HEADER=x-debugbuddy-secret
# N8N_WEBHOOK_AUTH_VALUE=your-shared-secret

# Encrypts Jira API tokens at rest (AES-256-GCM). REQUIRED: the API refuses to start without it.
# 32 random bytes as 64 hex characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it stable: changing it makes every stored Jira token undecryptable (users reconnect Jira).
ENCRYPTION_KEY=replace-with-64-hex-characters

# Optional: comma-separated dashboard origins allowed to call /api/projects and /api/reports.
# Empty means any origin; those routes need a Supabase bearer token either way.
# DASHBOARD_ORIGINS=http://localhost:5173
